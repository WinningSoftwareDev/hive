{
  "name": "winningsoftware/hive",
  "description": "Hive — a production-ready Symfony 8 project template with Latte + Vue",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.4.1",
    "cloudbase/asset-node": "^1.0",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/orm": "^3.6",
    "knpuniversity/oauth2-client-bundle": "^2.20",
    "league/oauth2-github": "^3.1",
    "league/oauth2-google": "^4.2",
    "liip/monitor-bundle": "^2.25",
    "symfony/asset": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/mailer": "^8.1",
    "symfony/mime": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/var-exporter": "^8.1",
    "symfony/yaml": "^8.1",
    "winningsoftware/latte-helper": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/App/Tests"
    }
  },
  "scripts": {
    "stan": "php -d memory_limit=2G ./vendor/bin/phpstan analyse -c phpstan.neon",
    "cs": "./vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
    "cache:clean": "./bin/console cache:clear --env=prod --no-debug && ./bin/console cache:warmup --env=prod",
    "test": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --testdox --colors=always --coverage-html coverage --coverage-clover coverage/coverage.xml --testdox-html coverage/testdox.html",
    "ci-test": "php -d memory_limit=2G ./vendor/bin/phpunit --testdox --colors=always",
    "post-create-project-cmd": [
      "@php -r \"copy('.env.template', '.env');\"",
      "@php bin/console app:install",
      "mkdir -p var/cache var/log && chmod -R 777 var/",
      "rm -rf src/Application/Classes/ src/Application/Command/SetupCommand.php screenshots/"
    ]
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^13.3"
  }
}
