{extends '../../Core/Layout/@core.layout.latte'}
{varType App\Authentication\Entity\User $user}

{block content}
    <div class="w-full mt-12">
        <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
            <UserAccountHeader email="{$user->getEmail()}" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-8 space-y-6">
                <div class="bg-gray-800/40 p-8 rounded-3xl border border-gray-700/50 shadow-xl">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="h-px flex-1 bg-linear-to-r from-gray-700/50 to-transparent"></div>
                        <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest">Account Details</h2>
                        <div class="h-px flex-1 bg-linear-to-l from-gray-700/50 to-transparent"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase text-gray-500 font-bold tracking-wider">Email Address</label>
                            <p class="text-lg text-white font-medium">{$user->getEmail()}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-4">
                {if !$user->getOauthLinks()->isEmpty()}
                    <div class="bg-gray-800/40 p-8 rounded-3xl border border-gray-700/50 shadow-xl">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="h-px flex-1 bg-linear-to-r from-gray-700/50 to-transparent"></div>
                            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest">Connected Accounts</h2>
                            <div class="h-px flex-1 bg-linear-to-l from-gray-700/50 to-transparent"></div>
                        </div>

                        <div class="space-y-3">
                            {foreach $user->getOauthLinks() as $link}
                                <div class="flex items-center gap-3 p-3 rounded-xl border border-gray-700/30 bg-gray-800/20">
                                    <i class="{$link->getProvider()->getIcon()} text-lg text-gray-400"></i>
                                    <div class="space-y-0.5">
                                        <p class="text-sm font-semibold text-gray-300">{$link->getProvider()->getName()}</p>
                                        <p class="text-[11px] text-gray-500">Connected</p>
                                    </div>
                                </div>
                            {/foreach}
                        </div>
                    </div>
                {/if}
            </div>
        </div>
    </div>
{/block}